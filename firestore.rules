rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者判定 (tvvvvt@gmail.com, sakurai@solaris.vc)
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == "tvvvvt@gmail.com" || 
         request.auth.token.email == "sakurai@solaris.vc");
    }

    // ユーザープロフィール
    // - 読み取り: 全員（投げ銭一覧での名前・アバター表示等のため）
    // - 書き込み: 本人または管理者
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 投げ銭 (Tips) フィード
    // - 読み取り: 全員（ライブフィード・タイムライン表示）
    // - 新規作成: ログイン中ユーザー
    // - 更新・削除: 管理者のみ
    match /tips/{tipId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // アーティスト情報・タイムテーブル
    // - 読み取り: 全員
    // - 書き込み: 管理者のみ
    match /artists/{artistId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // イベント基本情報
    // - 読み取り: 全員
    // - 書き込み: 管理者のみ
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // バックオフィス管理画面共有データ
    // - 読み書き: 管理者のみ
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
